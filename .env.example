# FlowCRM Environment Variables Template

# Application
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# PostgreSQL Database
DATABASE_URL=jdbc:postgresql://localhost:5432/flowcrm_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_secure_pass

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost

# Mail Provider Configuration (Placeholder)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=mail_user
MAIL_PASSWORD=mail_pass

# AWS S3 Storage (Placeholder)
AWS_REGION=us-east-1
AWS_BUCKET=flowcrm-attachments-dev
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
